<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
         http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.4.xsd">

  <changeSet id="01" author="Eric Jesse">
    <!--
      Cache of which fields and tags are actually populated for each meter name, used to
      provide relevant suggestions when configuring a data series.  The table is refreshed
      periodically by chunk (oldest entries first).
    -->
    <createTable tableName="meter_name_stats">
      <column name="tenant" type="varchar(30)">
        <constraints nullable="false"/>
      </column>
      <column name="name" type="text">
        <constraints nullable="false"/>
      </column>
      <!-- JSON array of field names that contain non-null values for this meter, e.g. ["count","mean","max"] -->
      <column name="fields" type="jsonb">
        <constraints nullable="false"/>
      </column>
      <!-- JSON object mapping tag key -> sorted array of distinct values, e.g. {"env":["prod","staging"]} -->
      <column name="tags" type="jsonb">
        <constraints nullable="false"/>
      </column>
      <column name="last_updated" type="TIMESTAMP WITH TIME ZONE">
        <constraints nullable="false"/>
      </column>
    </createTable>

    <addPrimaryKey tableName="meter_name_stats" columnNames="tenant, name" constraintName="pk_meter_name_stats"/>

    <createIndex tableName="meter_name_stats" indexName="meter_name_stats_last_updated_idx">
      <column name="last_updated"/>
    </createIndex>
  </changeSet>

</databaseChangeLog>
